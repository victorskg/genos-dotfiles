#!/usr/bin/env bash
set -Eeuo pipefail

script=$(readlink -f "$0")
genos=$(dirname "$script")
palette="$genos/palette.conf"
mode="${1:-toggle}"
current=$(awk -F= '$1=="opacity_mode" { print $2; exit }' "$palette")

case "$mode" in
  transparent|opaque) next=$mode ;;
  toggle)
    if [[ "$current" == "opaque" ]]; then next=transparent; else next=opaque; fi
    ;;
  *)
    echo "usage: opacity-mode [transparent|opaque|toggle]" >&2
    exit 1
    ;;
esac

tmp=$(mktemp)
awk -F= -v next="$next" '
  BEGIN { OFS = "=" }
  $1 == "opacity_mode" { $2 = next }
  { print }
' "$palette" > "$tmp"
mv "$tmp" "$palette"

"$genos/apply-theme"

if command -v hyprctl >/dev/null 2>&1; then
  hyprctl reload >/dev/null || true
fi
if pid=$(pidof waybar); then
  kill -SIGUSR2 $pid || true
fi
if command -v makoctl >/dev/null 2>&1; then
  makoctl reload || true
fi

echo "opacity mode: $next"

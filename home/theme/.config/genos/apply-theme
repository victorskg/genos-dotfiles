#!/usr/bin/env bash
set -Eeuo pipefail

script=$(readlink -f "$0")
genos=$(dirname "$script")
root=$(cd "$genos/../../../.." && pwd)
palette="$genos/palette.conf"

declare -A val
while IFS= read -r line || [[ -n "$line" ]]; do
  line="${line%%#*}"
  line="${line#"${line%%[![:space:]]*}"}"
  line="${line%"${line##*[![:space:]]}"}"
  [[ -z "$line" ]] && continue
  [[ "$line" == *=* ]] || { echo "Invalid palette line: $line" >&2; exit 1; }
  val["${line%%=*}"]="${line#*=}"
done < "$palette"

need() {
  [[ -n "${val[$1]:-}" ]] || { echo "Missing palette key: $1" >&2; exit 1; }
}

for key in \
  variant opacity_mode \
  bg surface overlay line fg muted faint \
  blood blood_dim blood_bright violet violet_dim violet_bright gold steel \
  success warning error \
  opacity_terminal opacity_bar opacity_launcher opacity_notifications opacity_lock \
  blur_size blur_passes blur_noise blur_brightness blur_vibrancy \
  gap_in gap_out border radius_window radius_popup bar_height bar_spacing \
  font_ui font_term font_lock \
  font_ui_family font_term_family font_lock_family font_icon_family
do
  need "$key"
done

case "${val[variant]}" in
  blood)
    val[accent]=${val[blood]}
    val[accent_dim]=${val[blood_dim]}
    val[accent_bright]=${val[blood_bright]}
    val[secondary]=${val[violet]}
    val[secondary_bright]=${val[violet_bright]}
    ;;
  eclipse)
    val[accent]=${val[violet]}
    val[accent_dim]=${val[violet_dim]}
    val[accent_bright]=${val[violet_bright]}
    val[secondary]=${val[blood]}
    val[secondary_bright]=${val[blood_bright]}
    ;;
  *)
    echo "Unknown variant: ${val[variant]}" >&2
    exit 1
    ;;
esac

case "${val[opacity_mode]}" in
  transparent)
    val[blur_enabled]=true
    ;;
  opaque)
    val[blur_enabled]=false
    for key in opacity_terminal opacity_bar opacity_launcher opacity_notifications opacity_lock; do
      val[$key]=1
    done
    ;;
  *)
    echo "Unknown opacity_mode: ${val[opacity_mode]}" >&2
    exit 1
    ;;
esac

hex() { printf '%s' "${val[$1],,}"; }

lua_quote() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  printf '"%s"' "$s"
}

ahex() {
  awk -v v="${val[$1]}" 'BEGIN { printf "%02x", int(v * 255 + 0.5) }'
}

rgba_css() {
  local h a
  h="$(hex "$1")"
  a="${val[$2]}"
  printf 'rgba(%d, %d, %d, %s)' "$((16#${h:0:2}))" "$((16#${h:2:2}))" "$((16#${h:4:2}))" "$a"
}

mkdir -p \
  "$root/home/hypr/.config/hypr" \
  "$root/home/kitty/.config/kitty" \
  "$root/home/fuzzel/.config/fuzzel" \
  "$root/home/mako/.config/mako" \
  "$root/home/waybar/.config/waybar" \
  "$root/home/gtk/.config/gtk-3.0"

cat > "$genos/colors.css" <<EOF
/* Generated by apply-theme from palette.conf. */
@define-color bg #$(hex bg);
@define-color surface #$(hex surface);
@define-color overlay #$(hex overlay);
@define-color line #$(hex line);
@define-color fg #$(hex fg);
@define-color muted #$(hex muted);
@define-color faint #$(hex faint);
@define-color accent #$(hex accent);
@define-color accent_dim #$(hex accent_dim);
@define-color accent_bright #$(hex accent_bright);
@define-color secondary #$(hex secondary);
@define-color secondary_bright #$(hex secondary_bright);
@define-color gold #$(hex gold);
@define-color steel #$(hex steel);
@define-color success #$(hex success);
@define-color warning #$(hex warning);
@define-color danger #$(hex error);
EOF

cat > "$root/home/hypr/.config/hypr/colors.conf" <<EOF
# Generated by apply-theme from palette.conf.

\$bg = rgba($(hex bg)ff)
\$surface = rgba($(hex surface)ff)
\$overlay = rgba($(hex overlay)ff)
\$line = rgba($(hex line)ff)
\$fg = rgba($(hex fg)ff)
\$muted = rgba($(hex muted)ff)
\$faint = rgba($(hex faint)ff)
\$accent = rgba($(hex accent)ff)
\$accent_dim = rgba($(hex accent_dim)ff)
\$accent_bright = rgba($(hex accent_bright)ff)
\$secondary = rgba($(hex secondary)ff)
\$gold = rgba($(hex gold)ff)
\$steel = rgba($(hex steel)ff)
\$success = rgba($(hex success)ff)
\$warning = rgba($(hex warning)ff)
\$danger = rgba($(hex error)ff)

\$gap_in = ${val[gap_in]}
\$gap_out = ${val[gap_out]}
\$border = ${val[border]}
\$radius_window = ${val[radius_window]}
\$radius_popup = ${val[radius_popup]}
\$font_ui = ${val[font_ui_family]}
\$font_lock = ${val[font_lock_family]}
\$font_lock_size = ${val[font_lock]}

\$blur_enabled = ${val[blur_enabled]}
\$blur_size = ${val[blur_size]}
\$blur_passes = ${val[blur_passes]}
\$blur_noise = ${val[blur_noise]}
\$blur_brightness = ${val[blur_brightness]}
\$blur_vibrancy = ${val[blur_vibrancy]}
\$opacity_lock = ${val[opacity_lock]}
EOF

cat > "$root/home/hypr/.config/hypr/colors.lua" <<EOF
-- Generated by apply-theme from palette.conf.
return {
  bg = "rgba($(hex bg)ff)",
  surface = "rgba($(hex surface)ff)",
  overlay = "rgba($(hex overlay)ff)",
  line = "rgba($(hex line)ff)",
  fg = "rgba($(hex fg)ff)",
  muted = "rgba($(hex muted)ff)",
  faint = "rgba($(hex faint)ff)",
  accent = "rgba($(hex accent)ff)",
  accent_dim = "rgba($(hex accent_dim)ff)",
  accent_bright = "rgba($(hex accent_bright)ff)",
  secondary = "rgba($(hex secondary)ff)",
  gold = "rgba($(hex gold)ff)",
  steel = "rgba($(hex steel)ff)",
  success = "rgba($(hex success)ff)",
  warning = "rgba($(hex warning)ff)",
  danger = "rgba($(hex error)ff)",

  gap_in = ${val[gap_in]},
  gap_out = ${val[gap_out]},
  border = ${val[border]},
  radius_window = ${val[radius_window]},
  radius_popup = ${val[radius_popup]},
  font_ui = $(lua_quote "${val[font_ui_family]}"),
  font_lock = $(lua_quote "${val[font_lock_family]}"),
  font_lock_size = ${val[font_lock]},

  blur_enabled = ${val[blur_enabled]},
  blur_size = ${val[blur_size]},
  blur_passes = ${val[blur_passes]},
  blur_noise = ${val[blur_noise]},
  blur_brightness = ${val[blur_brightness]},
  blur_vibrancy = ${val[blur_vibrancy]},
  opacity_lock = ${val[opacity_lock]},
}
EOF

cat > "$root/home/kitty/.config/kitty/opacity.conf" <<EOF
# Generated by apply-theme from palette.conf.
background_opacity ${val[opacity_terminal]}
EOF

cat > "$root/home/fuzzel/.config/fuzzel/colors.ini" <<EOF
# Generated by apply-theme from palette.conf.

font=${val[font_ui_family]}:size=${val[font_ui]}

[colors]
background=$(hex surface)$(ahex opacity_launcher)
text=$(hex fg)ff
prompt=$(hex muted)ff
placeholder=$(hex muted)ff
input=$(hex fg)ff
match=$(hex accent_bright)ff
selection=$(hex accent)ff
selection-text=$(hex fg)ff
selection-match=$(hex fg)ff
border=$(hex accent_bright)ff

[border]
width=${val[border]}
radius=${val[radius_window]}
EOF

cat > "$root/home/mako/.config/mako/colors" <<EOF
# Generated by apply-theme from palette.conf.

background-color=#$(hex surface)$(ahex opacity_notifications)
text-color=#$(hex fg)
border-color=#$(hex accent_bright)
border-size=${val[border]}
border-radius=${val[radius_popup]}
font=${val[font_ui_family]} ${val[font_ui]}
padding=12
width=380
default-timeout=5000
EOF

cat > "$root/home/waybar/.config/waybar/font.css" <<EOF
/* Generated by apply-theme from palette.conf. */
* {
    font-family: "${val[font_ui_family]}", Helvetica, Arial, sans-serif, "${val[font_icon_family]}";
    font-size: ${val[font_ui]}px;
    font-weight: normal;
}
EOF

cat > "$root/home/waybar/.config/waybar/surface.css" <<EOF
/* Generated by apply-theme from palette.conf. */
window#waybar {
    background-color: transparent;
}

.modules-left,
.modules-center,
.modules-right {
    background-color: $(rgba_css surface opacity_bar);
}
EOF

cat > "$root/home/gtk/.config/gtk-3.0/settings.ini" <<EOF
[Settings]
gtk-application-prefer-dark-theme=1
gtk-font-name=${val[font_ui_family]} ${val[font_term]}
EOF

echo "GenOS theme written from $palette (${val[variant]}, ${val[opacity_mode]})"

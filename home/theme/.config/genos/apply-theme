#!/usr/bin/env bash
set -Eeuo pipefail

script=$(readlink -f "$0")
genos=$(dirname "$script")
root=$(cd "$genos/../../../.." && pwd)
palette="$genos/palette.conf"

declare -A val
while IFS= read -r line || [[ -n "$line" ]]; do
  line="${line%%#*}"
  line="${line#"${line%%[![:space:]]*}"}"
  line="${line%"${line##*[![:space:]]}"}"
  [[ -z "$line" ]] && continue
  [[ "$line" == *=* ]] || { echo "Invalid palette line: $line" >&2; exit 1; }
  val["${line%%=*}"]="${line#*=}"
done < "$palette"

need() {
  [[ -n "${val[$1]:-}" ]] || { echo "Missing palette key: $1" >&2; exit 1; }
}

for key in \
  bg surface overlay line fg muted faint accent danger warning \
  gap_in gap_out border radius_window radius_popup bar_height bar_spacing \
  font_ui font_term font_lock \
  font_ui_family font_term_family font_lock_family font_icon_family
do
  need "$key"
done

hex() { printf '%s' "${val[$1],,}"; }

mkdir -p \
  "$root/home/hypr/.config/hypr" \
  "$root/home/kitty/.config/kitty" \
  "$root/home/fuzzel/.config/fuzzel" \
  "$root/home/mako/.config/mako" \
  "$root/home/waybar/.config/waybar" \
  "$root/home/gtk/.config/gtk-3.0"

cat > "$genos/colors.css" <<EOF
/* Generated by apply-theme from palette.conf. */
@define-color bg #$(hex bg);
@define-color surface #$(hex surface);
@define-color overlay #$(hex overlay);
@define-color line #$(hex line);
@define-color fg #$(hex fg);
@define-color muted #$(hex muted);
@define-color faint #$(hex faint);
@define-color accent #$(hex accent);
@define-color danger #$(hex danger);
@define-color warning #$(hex warning);
EOF

cat > "$root/home/hypr/.config/hypr/colors.conf" <<EOF
# Generated by apply-theme from palette.conf.

\$bg = rgba($(hex bg)ff)
\$surface = rgba($(hex surface)ff)
\$overlay = rgba($(hex overlay)ff)
\$line = rgba($(hex line)ff)
\$fg = rgba($(hex fg)ff)
\$muted = rgba($(hex muted)ff)
\$faint = rgba($(hex faint)ff)
\$accent = rgba($(hex accent)ff)
\$danger = rgba($(hex danger)ff)
\$warning = rgba($(hex warning)ff)

\$gap_in = ${val[gap_in]}
\$gap_out = ${val[gap_out]}
\$border = ${val[border]}
\$radius_window = ${val[radius_window]}
\$radius_popup = ${val[radius_popup]}
\$font_ui = ${val[font_ui_family]}
\$font_lock = ${val[font_lock_family]}
\$font_lock_size = ${val[font_lock]}
EOF

cat > "$root/home/kitty/.config/kitty/colors.conf" <<EOF
# Generated by apply-theme from palette.conf.

font_family ${val[font_term_family]}
font_size ${val[font_term]}.0
background #$(hex bg)
foreground #$(hex fg)
cursor #$(hex accent)
selection_background #$(hex accent)
selection_foreground #$(hex bg)
EOF

cat > "$root/home/fuzzel/.config/fuzzel/colors.ini" <<EOF
# Generated by apply-theme from palette.conf.

font=${val[font_ui_family]}:size=${val[font_term]}

[colors]
background=$(hex surface)ff
text=$(hex fg)ff
prompt=$(hex muted)ff
placeholder=$(hex faint)ff
input=$(hex fg)ff
match=$(hex accent)ff
selection=$(hex accent)ff
selection-text=$(hex bg)ff
selection-match=$(hex bg)ff
border=$(hex accent)ff

[border]
width=${val[border]}
radius=${val[radius_window]}
EOF

cat > "$root/home/mako/.config/mako/colors" <<EOF
# Generated by apply-theme from palette.conf.

background-color=#$(hex surface)FF
text-color=#$(hex fg)FF
border-color=#$(hex accent)FF
border-size=${val[border]}
border-radius=${val[radius_popup]}
font=${val[font_ui_family]} ${val[font_term]}
EOF

cat > "$root/home/waybar/.config/waybar/font.css" <<EOF
/* Generated by apply-theme from palette.conf. */
* {
    font-family: "${val[font_ui_family]}", Helvetica, Arial, sans-serif, "${val[font_icon_family]}";
    font-size: ${val[font_ui]}px;
    font-weight: normal;
}
EOF

cat > "$root/home/gtk/.config/gtk-3.0/settings.ini" <<EOF
[Settings]
gtk-application-prefer-dark-theme=1
gtk-font-name=${val[font_ui_family]} ${val[font_term]}
EOF

echo "Cinder theme written from $palette"

{
  "layer": "top",
  "position": "left",
  "width": 52,
  "margin-top": 12,
  "margin-bottom": 12,
  "margin-left": 12,
  "spacing": 12,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": [
    "custom/media",
    "cpu",
    "memory",
    "bluetooth",
    "network",
    "pulseaudio",
    "battery",
    "custom/power"
  ],

  "hyprland/workspaces": {
    "all-outputs": true,
    "ignore-workspaces": ["^ext-.*"],
    "format": "󰧟",
    "workspace-taskbar": {
      "enable": true,
      "update-active-window": true,
      "active-window-position": "first",
      "icon-size": 20,
      "max-icons": 1,
      "format": "{icon}"
    }
  },

  "clock": {
    "format": "{:%H\n%M}",
    "tooltip": true,
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "first-day-of-week": 1,
      "weeks-pos": "left",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#e4dcd2'><b>{}</b></span>",
        "weekdays": "<span color='#b8aca6'><b>{}</b></span>",
        "weeks": "<span color='#8a7f7a'><b>{}</b></span>",
        "days": "<span color='#e4dcd2'>{}</span>",
        "today": "<span color='#c1121f'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down",
      "on-click-right": "mode"
    }
  },

  "custom/media": {
    "exec": "python3 $HOME/.config/waybar/media.py",
    "return-type": "json",
    "format": "{text}",
    "escape": true,
    "interval": 1,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next"
  },

  "cpu": {
    "interval": 5,
    "format": "󰻠",
    "tooltip-format": "{usage}%",
    "states": {
      "warning": 70,
      "critical": 90
    }
  },

  "memory": {
    "interval": 5,
    "format": "󰍛",
    "tooltip-format": "{percentage}%",
    "states": {
      "warning": 70,
      "critical": 90
    }
  },

  "network": {
    "format-wifi": "{icon}",
    "format-ethernet": "{icon}",
    "format-linked": "{icon}",
    "format-disconnected": "{icon}",
    "format-disabled": "{icon}",
    "format-icons": {
      "wifi": ["󰤟", "󰤢", "󰤥", "󰤨"],
      "ethernet": "󰈀",
      "linked": "󰈀",
      "disconnected": "󰖪",
      "disabled": "󰖪"
    },
    "tooltip-format-wifi": "{essid}",
    "tooltip-format-ethernet": "Ethernet",
    "tooltip-format-linked": "Ethernet",
    "tooltip-format-disconnected": "Disconnected",
    "tooltip-format-disabled": "Off",
    "on-click": "sh -c 'exec \"$HOME/.local/bin/waybar-wifi\"'"
  },

  "bluetooth": {
    "format-on": "󰂯",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected": "󰂯",
    "format-no-controller": "󰂲",
    "tooltip-format-on": "On",
    "tooltip-format-off": "Off",
    "tooltip-format-disabled": "Disabled",
    "tooltip-format-no-controller": "No adapter",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "kitty --class bluetui -e bluetui"
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰖁",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "tooltip-format": "{volume}%",
    "on-click": "sh -c 'exec \"$HOME/.local/bin/waybar-audio\"'"
  },

  "battery": {
    "interval": 30,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}",
    "format-charging": "{icon}",
    "format-plugged": "{icon}",
    "format-full": "{icon}",
    "format-icons": ["󰂎", "󰁻", "󰁿", "󰂁", "󰁹"],
    "format-time": "{H}h {M}m",
    "tooltip-format": "{capacity}% {time}"
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "$HOME/.config/waybar/power-menu.xml",
    "menu-actions": {
      "lock": "hyprlock",
      "reboot": "systemctl reboot",
      "poweroff": "systemctl poweroff"
    }
  }
}

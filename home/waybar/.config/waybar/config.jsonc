{
  "layer": "top",
  "position": "top",
  "height": 28,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["hyprland/window"],
  "modules-right": ["network", "pulseaudio", "clock"],

  "clock": {
    "format": "{:%H:%M  %a %d %b}"
  },

  "network": {
    "format-wifi": "Wi-Fi {essid}",
    "format-ethernet": "Ethernet",
    "format-disconnected": "Offline"
  },

  "pulseaudio": {
    "format": "Audio {volume}%",
    "format-muted": "Muted"
  }
}

